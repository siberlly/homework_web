# Local secrets for running the app. This file is git-ignored and
# docker-ignored, so it is never committed or baked into the image.
# Copy this file to .env and fill in your own values.
#
# BREVO_API_KEY: create one at https://app.brevo.com/settings/keys/api
# MAIL_FROM: a sender you verified in Brevo, in "Name <email>" form.
#            A Gmail address works, e.g. Your Name <you@gmail.com>
BREVO_API_KEY=xkeysib-your-api-key
MAIL_FROM=Email Servlet <you@gmail.com>
